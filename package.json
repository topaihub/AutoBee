{
  "name": "autobee-desktop",
  "version": "0.1.0",
  "description": "桌面版路线规划（Tauri + Svelte 5 + Tailwind 4 + shadcn 风格组件）",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "//test:rust": "必须带 --workspace:不带时只测根包 autobee,route-core 的算路/坐标系/解码单测与 shell 的地图工具单测都不会跑 —— 而那些是本项目最值钱的测试。build-app.bat 的 [3/6] 质量门走的就是这条。",
    "test:rust": "scripts\\cargo-msvc.bat test --workspace",
    "clippy": "scripts\\cargo-msvc.bat clippy --workspace --all-targets -- -D warnings",
    "fmt:rust": "scripts\\cargo-msvc.bat fmt --all -- --check",
    "fmt:rust:fix": "scripts\\cargo-msvc.bat fmt --all",
    "dev:app": "scripts\\dev.bat",
    "build:app": "scripts\\build-app.bat",
  "//smoke:cli": "跑在打包产物上,不是 cargo run:§3.1 约束一是「exe 真的往控制台打字」,而 windows_subsystem 只在 release 生效,debug 能过而 release 静默是可能的。没配 Key 时算路那几条会 SKIP 而不是 FAIL。",
  "smoke:cli": "node scripts/smoke-cli.mjs",
    "verify": "pnpm run check && pnpm run lint && pnpm run test && pnpm run test:rust && pnpm run clippy && pnpm run fmt:rust",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=22.12"
  },
  "//deps": "插件版本必须与 src-tauri/Cargo.toml 的 Rust crate 同 major/minor，否则 tauri build 拒绝构建。",
  "dependencies": {
    "@ouraihub/aether-ui": "github:ouraihub/Aether#91b10f7c4a9356e41f9e7859593afe7bebab314a&path:packages/ui",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "shadcn-svelte": "1.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoBee",
  "version": "0.1.0",
  "identifier": "com.autobee.desktop",
  "build": {
    "beforeDevCommand": "node tools/pnpm-standalone/package/bin/pnpm.mjs run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node tools/pnpm-standalone/package/bin/pnpm.mjs run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "路线规划",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的能力。地图请求全在 Rust 侧；大模型、会话、Skills、MCP、日志走 Aether 插件，五个特性都常开编译，所以静态列出。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "aether:logs",
    "aether:providers",
    "aether:chat",
    "aether:chat-history",
    "aether:skills",
    "aether:mcp-client"
  ]
}
